NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VELTRIXAE_API_URL=
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Privacy-conscious error monitoring. Leave empty to disable telemetry entirely.
# Never place wallet secrets, signed XDR, or sensitive account data in these values.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TELEMETRY_ENABLED=false
# Sampling rates (0.0 - 1.0). Keep low in production to limit data collection.
NEXT_PUBLIC_TELEMETRY_ERROR_SAMPLE_RATE=0.1
NEXT_PUBLIC_TELEMETRY_TRACE_SAMPLE_RATE=0.05
# Web-vitals reporting endpoint (optional). Leave empty to disable reporting.
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=
NEXT_PUBLIC_WEB_VITALS_ENABLED=false

# ---------------------------------------------------------------------------
# Request-ID correlation
# ---------------------------------------------------------------------------
# Header used to correlate frontend errors with backend request identifiers.
NEXT_PUBLIC_REQUEST_ID_HEADER=x-request-id
# Propagate the request ID to the backend on API calls.
NEXT_PUBLIC_REQUEST_ID_PROPAGATION=true

# ---------------------------------------------------------------------------
# Verified contract configuration
# ---------------------------------------------------------------------------
# Contract IDs must be verified before Mainnet can be enabled.
NEXT_PUBLIC_VELTRIXAE_CONTRACT_ID=
NEXT_PUBLIC_VELTRIXAE_CONTRACT_VERIFIED=false
# Optional checksum / build hash of the verified contract artifact.
NEXT_PUBLIC_VELTRIXAE_CONTRACT_CHECKSUM=

# ---------------------------------------------------------------------------
# Mainnet readiness gate
# ---------------------------------------------------------------------------
# Mainnet is disabled by default. Enabling requires verified contracts AND an
# explicit release flag. The build fails if this is enabled without both.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_MAINNET_ENABLED=false
NEXT_PUBLIC_MAINNET_RELEASE_FLAG=
# Release identifier used for rollback and incident correlation.
NEXT_PUBLIC_RELEASE_VERSION=
NEXT_PUBLIC_RELEASE_COMMIT=