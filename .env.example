NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VELTRIXAE_API_URL=
NEXT_PUBLIC_VELTRIXAE_API_VERSION=v1
NEXT_PUBLIC_VELTRIXAE_API_KEY=
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar network configuration
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Verified Stellar Testnet contract registry
# All contract IDs must reference verified Testnet deployments.
# Unverified or wrong-network contracts disable write actions.
NEXT_PUBLIC_VELTRIXAE_SWAP_CONTRACT_ID=
NEXT_PUBLIC_VELTRIXAE_FACTORY_CONTRACT_ID=
NEXT_PUBLIC_VELTRIXAE_ROUTER_CONTRACT_ID=
NEXT_PUBLIC_VELTRIXAE_POOL_CONTRACT_IDS=

# Contract registry metadata
NEXT_PUBLIC_VELTRIXAE_CONTRACT_DEPLOYMENT_LEDGER=
NEXT_PUBLIC_VELTRIXAE_CONTRACT_SOURCE_COMMIT=
NEXT_PUBLIC_VELTRIXAE_CONTRACT_VERIFICATION_STATUS=unverified